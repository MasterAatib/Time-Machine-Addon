{
  "format_version": "1.21.30",
  "minecraft:dimension": {
    "identifier": "sp:burning_earth",
    "generator": {
      "type": "minecraft:noise",
      "biome_source": {
        "type": "fixed",
        "biome": "sp:burning_earth_biome"
      },
      "settings": "minecraft:overworld_generation"  // uses overworld noise but with custom biome surface
    },
    "components": {
      "minecraft:dimension_bounds": {
        "min_y": -64,
        "max_y": 200
      },
      "minecraft:dimension_sky": {
        "fog_color": "#8B0000",      // dark red
        "sky_color": "#4A0B0B",
        "cloud_color": "#2B0B0B",
        "horizon_color": "#3A0A0A"
      },
      "minecraft:dimension_light": {
        "base_light": 2,            // slightly darker than Overworld
        "light_type": "minecraft:block"
      }
    }
  }
}