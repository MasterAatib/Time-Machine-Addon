{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sp:ember_particle",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/soft_mote"
      }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": true, "rotation": false },
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 0 },
      "minecraft:emitter_shape_point": { "offset": [0, 0, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": 2.2 },
      "minecraft:particle_initial_speed": 0.6,
      "minecraft:particle_initial_spin": { "rotation": 0, "rotation_rate": 5 },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.9, 0],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.12, 0.12],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": ["#FFE9A6", "#FF8A3D 55%", "#5A160500 100%"],
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
